<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- IMAGEM -->
        <ImageView
            android:id="@+id/item_image"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginBottom="12dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop" />

        <!-- NOME -->
        <TextView
            android:id="@+id/item_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- SERVIÇO -->
        <TextView
            android:id="@+id/item_servico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Serviço"
            android:textColor="#424242"
            android:textSize="15sp"
            android:layout_marginBottom="4dp" />

        <!-- DATA -->
        <TextView
            android:id="@+id/item_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data"
            android:textColor="#424242"
            android:textSize="15sp"
            android:layout_marginBottom="4dp" />

        <!-- HORÁRIO -->
        <TextView
            android:id="@+id/item_horario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Horário"
            android:textColor="#424242"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <!-- ENDEREÇO -->
        <TextView
            android:id="@+id/item_endereco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endereço"
            android:textColor="#5E35B1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- GÊNERO -->
        <TextView
            android:id="@+id/item_genero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gênero"
            android:textColor="#424242"
            android:textSize="15sp"
            android:layout_marginBottom="4dp" />

        <!-- NASCIMENTO -->
        <TextView
            android:id="@+id/item_nascimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nascimento"
            android:textColor="#424242"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <!-- BOTÃO MAPS -->
        <Button
            android:id="@+id/buttonMaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Abrir no Maps"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE"
            android:padding="10dp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>