<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dashboard.DashboardFragment">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/text_dashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastro de Agendamentos"
        android:textSize="20sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- IMAGEM -->
    <ImageView
        android:id="@+id/image_item"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/gallery_thumb"
        app:layout_constraintTop_toBottomOf="@id/text_dashboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÃO IMAGEM -->
    <Button
        android:id="@+id/button_select_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecionar Imagem"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/image_item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- NOME -->
    <EditText
        android:id="@+id/nomeItemEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nome"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/button_select_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ENDEREÇO -->
    <EditText
        android:id="@+id/enderecoItemEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Endereço"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/nomeItemEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- GÊNERO -->
    <EditText
        android:id="@+id/generoItemEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Gênero"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/enderecoItemEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- NASCIMENTO -->
    <EditText
        android:id="@+id/nascimentoItemEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Data de Nascimento"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/generoItemEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- DATA -->
    <EditText
        android:id="@+id/dataItemEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Data"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/nascimentoItemEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- HORÁRIO -->
    <EditText
        android:id="@+id/horarioItemEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Horário"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/dataItemEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SERVIÇO -->
    <EditText
        android:id="@+id/servicoItemEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Serviço"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/horarioItemEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/salvarItemButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:text="Salvar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/generoItemEditText" />
    </androidx.constraintlayout.widget.ConstraintLayout>
